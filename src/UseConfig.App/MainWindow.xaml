<Window x:Class="UseConfig.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Use Config"
        Width="960" Height="600"
        MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="Segoe UI" FontSize="14" Loaded="WindowLoaded">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="24">
        <TextBlock Text="Use Config" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Margin="0,12,0,0"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Text="Choose an existing empty catalog or initialize an empty folder. Catalogs with topics or entries will be supported in a later step."
                   TextWrapping="Wrap" />
        <StackPanel x:Name="Actions" Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="Open catalog" Click="OpenCatalog" />
            <Button Content="Create catalog" Click="CreateCatalog" />
            <Button x:Name="RetryButton" Content="Retry" Click="RetryCatalog" IsEnabled="False" />
        </StackPanel>
        <TextBlock Text="Catalog path" Margin="0,20,0,6" />
        <TextBlock x:Name="CatalogPath" Text="No catalog selected." TextWrapping="Wrap" />
        <TextBlock x:Name="Status" Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</Window>
