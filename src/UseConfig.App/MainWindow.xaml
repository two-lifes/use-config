<Window x:Class="UseConfig.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Use Config" Width="960" Height="600" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterScreen" Loaded="WindowLoaded"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="{StaticResource BodyFontFamily}" FontSize="{StaticResource BodyFontSize}">
    <Grid Margin="{StaticResource OuterPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Use Config" Style="{StaticResource HeadingTextStyle}" />
            <ProgressBar x:Name="Loading" Visibility="Collapsed" Height="4" Margin="{StaticResource SectionGap}"
                         Foreground="{StaticResource AccentBrush}" Background="{StaticResource ElevatedBrush}"
                         AutomationProperties.Name="Catalog operation in progress" />
        </StackPanel>
        <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Margin="{StaticResource SectionGap}">
            <StackPanel x:Name="ContentArea">
                <TextBlock x:Name="Status" Margin="{StaticResource FieldGap}" TextWrapping="Wrap"
                           Style="{StaticResource SecondaryTextStyle}" AutomationProperties.LiveSetting="Polite" />
                <StackPanel x:Name="StartView">
                    <TextBlock Text="Choose a catalog" Style="{StaticResource PanelHeadingTextStyle}" />
                    <TextBlock Margin="{StaticResource SectionGap}" Style="{StaticResource SecondaryTextStyle}"
                               Text="Open an existing Markdown catalog or create one in an empty folder." TextWrapping="Wrap" />
                    <TextBlock Margin="{StaticResource SectionGap}" Style="{StaticResource SecondaryTextStyle}"
                               Text="Markdown files, ZIP backups, and service recovery copies contain plaintext usernames and passwords. Masking passwords in the app does not encrypt these files." TextWrapping="Wrap" />
                    <WrapPanel Margin="{StaticResource AreaGap}">
                        <Button x:Name="OpenButton" Style="{StaticResource PrimaryButtonStyle}" Margin="{StaticResource ButtonGap}" Content="Open catalog" Click="OpenCatalog" />
                        <Button Margin="{StaticResource ButtonGap}" Content="Create catalog" Click="CreateCatalog" />
                        <Button x:Name="BackButton" Content="Return to catalog" Click="BackToCatalog" Visibility="Collapsed" />
                    </WrapPanel>
                    <TextBlock Text="Remembered catalog" Margin="{StaticResource LabelGap}" />
                    <TextBlock x:Name="RememberedPath" Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                    <StackPanel x:Name="AttemptPanel" Visibility="Collapsed">
                        <TextBlock Text="Selected location" Margin="{StaticResource LabelGap}" />
                        <TextBlock x:Name="AttemptedPath" Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="CatalogView" Visibility="Collapsed">
                    <Button x:Name="ChangeButton" Content="Change catalog" HorizontalAlignment="Left" Click="ChangeCatalog" />
                    <TextBlock Text="Catalog path" Margin="{StaticResource LabelGap}" />
                    <TextBlock x:Name="CatalogPath" Style="{StaticResource TechnicalTextStyle}" TextWrapping="Wrap" />
                    <ItemsControl x:Name="CatalogErrors" Margin="{StaticResource SectionGap}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="{StaticResource FieldGap}" Foreground="{StaticResource WarningBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel x:Name="RecoveryActions" Visibility="Collapsed" Margin="{StaticResource SectionGap}">
                        <TextBlock Text="Save the previous version to a separate folder. The current catalog will not be changed." TextWrapping="Wrap" />
                        <ComboBox x:Name="RecoveryOperations" Style="{StaticResource CatalogComboBoxStyle}" DisplayMemberPath="Label" Margin="{StaticResource FieldGap}" AutomationProperties.Name="Recovery version" />
                        <Button Content="Save recovery copy" Click="SaveRecoveryCopy" HorizontalAlignment="Left" />
                    </StackPanel>
                    <TextBlock x:Name="EmptyState" Text="This catalog has no websites yet." TextWrapping="Wrap" Margin="{StaticResource SectionGap}" Visibility="Collapsed" />
                    <ItemsControl x:Name="CatalogRecords" Margin="{StaticResource SectionGap}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Button x:Name="RetryButton" Content="Retry" Click="RetryCatalog" HorizontalAlignment="Left" Margin="{StaticResource SectionGap}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
