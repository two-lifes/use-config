<Window x:Class="UseConfig.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Use Config"
        Width="960" Height="600"
        MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="{StaticResource BodyFontFamily}" FontSize="{StaticResource BodyFontSize}" Loaded="WindowLoaded">
    <StackPanel Margin="{StaticResource OuterPadding}">
        <TextBlock Text="Use Config" Style="{StaticResource HeadingTextStyle}" />
        <TextBlock Margin="{StaticResource SectionGap}"
                   Style="{StaticResource SecondaryTextStyle}"
                   Text="Choose an existing Markdown catalog or initialize an empty folder. Invalid files are preserved and reported below."
                   TextWrapping="Wrap" />
        <TextBlock Margin="{StaticResource SectionGap}"
                   Style="{StaticResource SecondaryTextStyle}"
                   Text="Markdown files, ZIP backups, and service recovery copies contain plaintext usernames and passwords. Masking passwords in the app does not encrypt these files."
                   TextWrapping="Wrap" />
        <StackPanel x:Name="Actions" Orientation="Horizontal" Margin="{StaticResource AreaGap}">
            <Button Style="{StaticResource PrimaryButtonStyle}" Margin="{StaticResource ButtonGap}" Content="Open catalog" Click="OpenCatalog" />
            <Button Margin="{StaticResource ButtonGap}" Content="Create catalog" Click="CreateCatalog" />
            <Button x:Name="RetryButton" Margin="{StaticResource ButtonGap}" Content="Retry" Click="RetryCatalog" IsEnabled="False" />
        </StackPanel>
        <StackPanel x:Name="RecoveryActions" Visibility="Collapsed" Margin="{StaticResource SectionGap}">
            <TextBlock Text="An interrupted operation needs recovery. Save the previous version to a separate folder; the current catalog will not be changed." TextWrapping="Wrap" />
            <ComboBox x:Name="RecoveryOperations" Style="{StaticResource CatalogComboBoxStyle}" DisplayMemberPath="Label" Margin="{StaticResource FieldGap}" />
            <Button Content="Save recovery copy" Click="SaveRecoveryCopy" HorizontalAlignment="Left" />
        </StackPanel>
        <TextBlock Text="Catalog path" Margin="{StaticResource LabelGap}" />
        <TextBlock x:Name="CatalogPath" Style="{StaticResource TechnicalTextStyle}" Text="No catalog selected." TextWrapping="Wrap" />
        <TextBlock x:Name="Status" Margin="{StaticResource SectionGap}" TextWrapping="Wrap"
                   Style="{StaticResource SecondaryTextStyle}"
                   AutomationProperties.LiveSetting="Polite" />
        <ScrollViewer MaxHeight="{StaticResource DiagnosticsMaxHeight}" VerticalScrollBarVisibility="Auto" Margin="{StaticResource SectionGap}">
            <ItemsControl x:Name="CatalogErrors" />
        </ScrollViewer>
        <ScrollViewer MaxHeight="{StaticResource RecordsMaxHeight}" VerticalScrollBarVisibility="Auto" Margin="{StaticResource SectionGap}">
            <ItemsControl x:Name="CatalogRecords" />
        </ScrollViewer>
    </StackPanel>
</Window>
