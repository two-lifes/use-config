<UserControl x:Class="UseConfig.App.CatalogPane"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <DockPanel>
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="Search websites (Ctrl+F)" />
   <DockPanel Margin="0,6,0,12">
    <Button DockPanel.Dock="Right" Content="Clear search" Click="ClearSearch" Margin="8,0,0,0" />
    <TextBox x:Name="SearchBox" TextChanged="SearchChanged" AutomationProperties.Name="Search websites" />
   </DockPanel>
   <TextBlock x:Name="EditorStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
  </StackPanel>
  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
   <Grid MinWidth="800">
    <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="240"/><ColumnDefinition Width="*" MinWidth="360"/></Grid.ColumnDefinitions>
    <DockPanel Margin="0,0,12,0">
     <TextBlock DockPanel.Dock="Top" Text="Folders" Style="{StaticResource PanelHeadingTextStyle}"/>
     <TextBlock x:Name="NoFolders" DockPanel.Dock="Top" Text="No folders. Add a topic directory following the Markdown format, then Retry." TextWrapping="Wrap"/>
     <ListBox x:Name="FolderList" DisplayMemberPath="Name" SelectionChanged="FolderChanged" AutomationProperties.Name="Folders" />
    </DockPanel>
    <DockPanel Grid.Column="1" Margin="0,0,12,0">
     <TextBlock DockPanel.Dock="Top" Text="Websites" Style="{StaticResource PanelHeadingTextStyle}"/>
     <TextBlock x:Name="NoWebsites" DockPanel.Dock="Top" TextWrapping="Wrap"/>
     <ListBox x:Name="WebsiteList" DisplayMemberPath="Name" SelectionChanged="WebsiteChanged" AutomationProperties.Name="Websites" />
    </DockPanel>
    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <TextBlock Text="Details" Style="{StaticResource PanelHeadingTextStyle}"/>
      <TextBlock x:Name="NoSelection" Text="Select a website to view its details." TextWrapping="Wrap"/>
      <StackPanel x:Name="Details">
       <TextBlock Text="Name"/><TextBlock x:Name="EntryName" TextWrapping="Wrap" Margin="0,6,0,12"/>
       <TextBlock Text="Primary URL"/><TextBlock x:Name="EntryUrl" TextWrapping="Wrap" Margin="0,6,0,12"/>
       <TextBlock Text="Username"/><TextBlock x:Name="EntryUsername" TextWrapping="Wrap" Margin="0,6,0,12"/>
       <TextBlock Text="Password"/><TextBlock Text="••••••••" Margin="0,6,0,12" AutomationProperties.Name="Password masked"/>
       <TextBlock Text="Additional URL"/><TextBlock x:Name="EntryAdditionalUrl" TextWrapping="Wrap" Margin="0,6,0,12"/>
       <TextBlock Text="2FA note"/><TextBlock x:Name="EntryNote" TextWrapping="Wrap" Margin="0,6,0,12"/>
       <TextBlock Text="Description"/>
       <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MaxHeight="240"
         VerticalScrollBarVisibility="Auto" TextChanged="DescriptionChanged" Margin="0,6,0,12" AutomationProperties.Name="Description"/>
       <TextBlock x:Name="ReadOnlyNotice" Text="Description is read-only. Repair the catalog and Retry." TextWrapping="Wrap"/>
       <WrapPanel><Button x:Name="SaveButton" Content="Save" Click="SaveDescription" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
        <Button x:Name="DiscardButton" Content="Discard" Click="DiscardDescription"/></WrapPanel>
      </StackPanel>
     </StackPanel>
    </ScrollViewer>
   </Grid>
  </ScrollViewer>
 </DockPanel>
</UserControl>
